<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite parallel="tests" name="MyTestSuite">
    <groups>
        <run>
            <include name="Purchase"/>
        </run>
    </groups>
    <listeners>
        <listener class-name="ecomapplication.testComponents.Listeners"></listener>
    </listeners>
    <test name="Submit Order Test">
        <classes>
            <class name="ecomapplication.tests.EcomE2E"/>
        </classes>
    </test>

    <test name="Error Validations Test">
        <classes>
            <class name="ecomapplication.tests.ErrorValidations"/>
        </classes>
    </test>
</suite>